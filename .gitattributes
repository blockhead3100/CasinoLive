# Enforce consistent line endings
* text=auto

# Explicitly declare text files we want to normalize
*.css text
*.html text
*.js text
*.json text
*.md text
*.py text
*.ts text
*.tsx text
*.yaml text
*.yml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary

# Ensure node_modules remains ignored
node_modules/ -text